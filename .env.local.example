NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
NEXT_PUBLIC_DEV_SUPABASE_REDIRECT_URL=http://localhost:3000
NEXT_PUBLIC_GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_KEY=your_gemini_api_key
GEMINI_TIMEOUT_MS=30000
GEMINI_MAX_RETRIES=2
GEMINI_RETRY_BASE_DELAY_MS=750
DISTILL_RATE_LIMIT_MAX_REQUESTS=12
DISTILL_RATE_LIMIT_WINDOW_MS=60000
CONTRADICTION_RATE_LIMIT_MAX_REQUESTS=5
CONTRADICTION_RATE_LIMIT_WINDOW_MS=300000
SERVER_LOG_LEVEL=info
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
# Generate with: openssl rand -base64 32
SUBSTACK_SESSION_ENCRYPTION_KEY=base64_encoded_32_byte_key
CRON_SECRET=a_long_random_value_used_by_vercel_cron
